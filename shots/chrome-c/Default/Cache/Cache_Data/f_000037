        <label for="lf-email">Email <span class="opt">(optional)</span></label>
        <input
          id="lf-email"
          formControlName="email"
          type="email"
          autocomplete="email"
          placeholder="name@company.com"
          [attr.aria-invalid]="showError('email') || null"
          [attr.aria-describedby]="showError('email') ? 'lf-email-err' : null"
        />
        @if (showError('email')) {
          <p class="err" id="lf-email-err">{{ errorText('email') }}</p>
        }
      </div>
    </div>
