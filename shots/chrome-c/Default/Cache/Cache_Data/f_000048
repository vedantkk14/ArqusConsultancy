              [attr.aria-label]="(p.pm_name ? 'Reassign ' : 'Assign a manager to ') + p.name"
            >
              {{ p.pm_name ? 'Reassign' : 'Assign' }}
            </button>
          }
        </dd>
      </div>
      <div>
        <dt>Start</dt>
        <dd>{{ day(p.start_date) || '\u2014' }}</dd>
      </div>
      <div>
        <dt>{{ p.status === 'COMPLETED' ? 'Completed' : 'Expected end' }}</dt>
        <dd [attr.title]="p.completed_at ? full(p.completed_at) : null">
          {{
            p.status === 'COMPLETED' && p.completed_at
              ? rel(p.completed_at)
              : day(p.expected_end_date) || '\u2014'
          }}
        </dd>
      </div>
    </dl>

    <div class="acts">
      @if (can('add_expense')) {
        <button
          matButton="filled"
          type="button"
          [attr.aria-label]="'Add expense to ' + p.name"
          (click)="addExpense()"
        >
          <mat-icon>add</mat-icon>Add expense
        </button>
      }
      @if (can('complete')) {
        <button
          matButton="outlined"
          type="button"
          [attr.aria-label]="'Complete ' + p.name"
          (click)="complete(p)"
        >
          <mat-icon>check_circle</mat-icon>Complete
        </button>
      }
      @if (can('reopen')) {
        <button
          matButton="outlined"
          type="button"
          [attr.aria-label]="'Reopen ' + p.name"
          (click)="reopen(p)"
        >
          <mat-icon>restart_alt</mat-icon>Reopen
        </button>
      }
