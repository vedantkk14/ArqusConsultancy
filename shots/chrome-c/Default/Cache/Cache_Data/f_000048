      <section class="card panel rise-in" style="--i: 2" aria-labelledby="exp-title">
        <app-panel-head
          title="Expenses"
          [subtitle]="
            expensesLoaded()
              ? expenseCount() + (expenseCount() === 1 ? ' expense' : ' expenses')
              : 'Loading\u2026'
          "
          headingId="exp-title"
        >
          <label class="cat-filter">
            <span class="sr-only">Filter expenses by category</span>
            <select class="ctl" (change)="setCategory($any($event.target).value)">
              <option value="" [selected]="!category()">All categories</option>
              @for (c of categories; track c[0]) {
                <option [value]="c[0]" [selected]="category() === c[0]">{{ c[1] }}</option>
              }
            </select>
          </label>
          @if (isAdmin()) {
            <button
              matButton="outlined"
              type="button"
              [disabled]="exporting()"
              [attr.aria-label]="'Download the expenses of ' + p.name + ' as an Excel file'"
              (click)="exportExcel(p)"
            >
              <mat-icon aria-hidden="true">table_view</mat-icon>{{ exporting() ? 'Preparing\u2026' : 'Export to Excel' }}
