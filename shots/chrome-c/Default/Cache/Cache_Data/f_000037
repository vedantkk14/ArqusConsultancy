          [attr.aria-describedby]="showError('name') ? 'lf-name-err' : null"
        />
        @if (showError('name')) {
          <p class="err" id="lf-name-err">{{ errorText('name') }}</p>
        }
      </div>

      <div class="field">
        <label for="lf-phone">Mobile number</label>
        <span class="prefixed" [class.invalid]="showError('phone')">
          <span class="pre" aria-hidden="true">+91</span>
          <input
            id="lf-phone"
            formControlName="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel-national"
            placeholder="98765 43210"
            [attr.aria-invalid]="showError('phone') || null"
            [attr.aria-describedby]="(showError('phone') ? 'lf-phone-err ' : '') + (duplicate() ? 'lf-dup' : '') || null"
