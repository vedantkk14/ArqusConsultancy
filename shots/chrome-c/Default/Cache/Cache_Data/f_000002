:root {
  --ink: #0b0d0f;
  --ink-2: #3b4250;
  --ink-3: #667085;
  --on-ink: #ffffff;
  --paper: #f6f7f9;
  --surface: #ffffff;
  --subtle: #f2f4f7;
  --surface-2: #f5f7fa;
  --line-cyan: #bfe7f5;
  --plate: #eaecf0;
  --line: #e7e9ed;
  --line-strong: #858d9a;
  --brand: #32c5f3;
  --brand-deep: #086f92;
  --brand-tint: #e6f7fd;
  --positive: #17663a;
  --positive-bg: #e3f4e8;
  --negative: #b42318;
  --negative-bg: #fdecea;
  --warning: #93370d;
  --warning-bg: #fef4e6;
  --tint-cyan: #e3f6fd;
  --tint-cyan-ink: #075e7c;
  --tint-teal: #dff5f1;
  --tint-teal-ink: #0b6152;
  --tint-amber: #fdf0d9;
  --tint-amber-ink: #86400b;
  --tint-rose: #fde7e7;
  --tint-rose-ink: #a52319;
  --tint-slate: #eef1f5;
  --tint-slate-ink: #3b4250;
  --deep-navy: #0e2a36;
  --data-cyan: #32c5f3;
  --data-teal: #2bb59b;
  --data-ink: #3b4250;
  --data-amber: #e3a008;
  --data-orange: #c2621d;
  --data-rose: #e5484d;
  --data-slate: #9aa4b2;
  --shadow-1: 0 1px 2px rgba(11, 13, 15, 0.05), 0 4px 12px rgba(11, 13, 15, 0.04);
  --shadow-2: 0 8px 24px rgba(11, 13, 15, 0.08), 0 2px 8px rgba(50, 197, 243, 0.1);
  --shadow-3: 0 20px 50px rgba(11, 13, 15, 0.14), 0 2px 6px rgba(11, 13, 15, 0.05);
  --highlight: inset 0 1px 0 rgba(255, 255, 255, 0.9);
  --glow-cyan: 0 4px 14px -6px rgba(50, 197, 243, 0.55);
  --grad-ink:
    linear-gradient(
      135deg,
      var(--ink) 0%,
      var(--deep-navy) 100%);
  --grad-brand:
    linear-gradient(
      135deg,
      var(--brand) 0%,
      #1aa6d6 100%);
  --grad-teal:
    linear-gradient(
      90deg,
      #2bb59b 0%,
      #17866f 100%);
  --grad-accent:
    linear-gradient(
      90deg,
      var(--brand),
      var(--brand-deep),
      var(--ink));
  --wash:
    radial-gradient(
      60% 45% at 100% 0%,
      rgba(50, 197, 243, 0.1),
      transparent 70%),
    radial-gradient(
      50% 40% at 0% 100%,
      rgba(160, 150, 140, 0.08),
      transparent 70%),
    var(--paper);
  --ring: 0 0 0 5px rgba(50, 197, 243, 0.35);
  --field-ring: 0 0 0 3px color-mix(in srgb, var(--brand-deep) 18%, transparent);
  --font-sans:
    "Geist Variable",
    system-ui,
    -apple-system,
    "Segoe UI",
    sans-serif;
  --text-xs: 12px;
  --text-sm: 13px;
  --text-base: 14px;
  --text-md: 16px;
  --text-lg: 20px;
  --text-xl: 24px;
  --text-kpi: 32px;
  --text-kpi-hero: 36px;
  --radius-card: 16px;
  --radius-control: 10px;
  --radius-sm: 8px;
  --radius-pill: 999px;
  --shadow-card: 0 1px 2px rgba(16, 24, 40, 0.04);
  --shadow-card-hover: 0 1px 2px rgba(16, 24, 40, 0.05), 0 6px 16px -4px rgba(16, 24, 40, 0.08);
  --shadow-pop: 0 12px 32px -8px rgba(16, 24, 40, 0.18), 0 2px 6px rgba(16, 24, 40, 0.06);
  --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
  --dur-fast: 120ms;
  --dur-base: 200ms;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;
  --space-10: 40px;
  --sidebar-w-expanded: 256px;
  --sidebar-w-rail: 72px;
  --topbar-h: 64px;
  --tabbar-h: 64px;
  --content-max: 1280px;
  --gutter: 16px;
}
@media (min-width: 768px) {
  :root {
    --gutter: 24px;
  }
