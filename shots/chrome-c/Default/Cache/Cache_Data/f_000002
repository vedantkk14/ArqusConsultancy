.auth label {
  transition: color 150ms ease;
}
.auth .field:focus-within > label {
  color: var(--brand-deep);
}
.auth input[type=text],
.auth input[type=email],
.auth input[type=password] {
  width: 100%;
  height: 48px;
  padding: 0 14px;
  border: 1px solid var(--line-strong);
  border-radius: 12px;
  background: var(--surface);
  box-shadow: inset 0 1px 2px rgba(11, 13, 15, 0.05);
  color: var(--ink);
  font: inherit;
  font-size: var(--text-md);
  transition: border-color 150ms ease, box-shadow 150ms ease;
}
.auth input[type=text]:hover,
.auth input[type=email]:hover,
.auth input[type=password]:hover {
  border-color: var(--ink-2);
}
.auth input[type=text]:focus-visible,
.auth input[type=email]:focus-visible,
.auth input[type=password]:focus-visible {
  border-color: var(--brand-deep);
  outline: 2px solid var(--brand-deep);
  outline-offset: 0;
  box-shadow: var(--ring);
}
.auth input[type=text]:disabled,
.auth input[type=email]:disabled,
.auth input[type=password]:disabled {
  background: var(--subtle);
  color: var(--ink-3);
}
.auth input[type=text]:-webkit-autofill,
.auth input[type=text]:-webkit-autofill:hover,
.auth input[type=text]:-webkit-autofill:focus,
.auth input[type=email]:-webkit-autofill,
.auth input[type=email]:-webkit-autofill:hover,
.auth input[type=email]:-webkit-autofill:focus,
.auth input[type=password]:-webkit-autofill,
.auth input[type=password]:-webkit-autofill:hover,
.auth input[type=password]:-webkit-autofill:focus {
  -webkit-text-fill-color: var(--ink);
  box-shadow: 0 0 0 40px var(--surface) inset;
  caret-color: var(--ink);
}
.auth .invalid input,
.auth input[aria-invalid=true] {
  border-color: var(--negative);
}
.auth .field-error {
  margin: 6px 0 0;
  color: var(--negative);
  font-size: var(--text-sm);
}
.auth .banner {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  margin: 0;
  padding: 11px 12px 11px 16px;
  border-radius: 12px;
  font-size: var(--text-sm);
  font-weight: 500;
  overflow: hidden;
}
.auth .banner::before {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  width: 3px;
  background: currentColor;
}
.auth .banner mat-icon {
  width: 18px;
  height: 18px;
  flex: none;
  font-size: 18px;
}
.auth .banner.error {
  background: var(--tint-rose);
  color: var(--tint-rose-ink);
}
.auth .banner.info {
  background: var(--tint-cyan);
  color: var(--tint-cyan-ink);
}
.auth .banner.success {
  background: var(--tint-teal);
  color: var(--tint-teal-ink);
}
.auth .submit {
  --mat-button-filled-container-height: 48px;
  --mat-button-filled-container-shape: 12px;
  position: relative;
  width: 100%;
  overflow: hidden;
  transition: transform 150ms var(--ease-out), box-shadow 150ms ease;
}
.auth .submit mat-spinner {
  display: inline-block;
  margin-right: var(--space-2);
  vertical-align: middle;
  --mat-progress-spinner-active-indicator-color: var(--on-ink);
}
.auth .submit:not(:disabled) {
  background: var(--grad-ink);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.12),
    0 1px 2px rgba(11, 13, 15, 0.2),
    0 8px 20px -6px rgba(11, 13, 15, 0.45);
}
.auth .submit:not(:disabled)::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      115deg,
      transparent 30%,
      rgba(255, 255, 255, 0.18) 50%,
      transparent 70%);
  transform: translateX(-110%);
  pointer-events: none;
}
.auth .submit:not(:disabled):hover {
  transform: translateY(-1px);
}
.auth .submit:not(:disabled):hover::after {
  transform: translateX(110%);
  transition: transform 900ms ease;
}
.auth .submit:not(:disabled):active {
  transform: translateY(1px);
}
.auth .control {
  position: relative;
}
.auth .control.has-icon input {
  padding-left: 42px;
  background: var(--surface-2);
}
.auth .control.has-icon input:focus {
  background: var(--surface);
}
.auth .control.has-icon .lead {
  position: absolute;
  top: 50%;
  left: 13px;
  z-index: 1;
  width: 20px;
  height: 20px;
  font-size: 20px;
  color: var(--ink-3);
  transform: translateY(-50%);
  transition: color 150ms ease;
  pointer-events: none;
}
.auth .control.has-icon:focus-within .lead {
  color: var(--brand-deep);
}
.auth .check input[type=checkbox] {
  display: grid;
  width: 18px;
  height: 18px;
  margin: 0;
  place-content: center;
  border: 1.5px solid var(--line-strong);
  border-radius: 5px;
  background: var(--surface);
  appearance: none;
  cursor: pointer;
  transition: background-color 150ms ease, border-color 150ms ease;
}
.auth .check input[type=checkbox]::after {
  content: "";
  width: 9px;
  height: 5px;
  border-bottom: 2px solid var(--brand);
  border-left: 2px solid var(--brand);
  opacity: 0;
  transform: translateY(-1px) rotate(-45deg);
}
.auth .check input[type=checkbox]:checked {
  border-color: var(--ink);
  background: var(--ink);
}
.auth .check input[type=checkbox]:checked::after {
  opacity: 1;
}
.auth .arrow-sm {
  width: 16px;
  height: 16px;
  margin-left: 2px;
  font-size: 16px;
  transition: transform 150ms ease;
}
.auth .link:hover .arrow-sm {
  transform: translateX(2px);
}
.auth .btn-arrow {
  width: 18px;
  height: 18px;
  margin-left: 6px;
  font-size: 18px;
  vertical-align: -4px;
  transition: transform 200ms var(--ease-out);
}
.auth .submit:not(:disabled):hover .btn-arrow {
  transform: translateX(3px);
}
.auth .help {
  margin-top: var(--space-5);
  padding-top: var(--space-4);
  border-top: 1px solid var(--line);
  text-align: center;
}
.auth .help p {
  margin: 0;
  color: var(--ink-3);
  font-size: var(--text-sm);
}
.auth .demo {
  width: 100%;
  max-width: 420px;
  color: var(--ink-2);
  font-size: var(--text-sm);
}
.auth .demo summary {
  min-height: 44px;
  padding: 12px 0;
  font-weight: 500;
  text-align: center;
  cursor: pointer;
}
.auth .demo summary span {
  color: var(--ink-3);
  font-weight: 400;
}
.auth .demo-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-2);
}
.auth .demo-chip {
  min-height: 36px;
  padding: 0 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--surface);
  box-shadow: var(--shadow-1);
  color: var(--ink);
  font: inherit;
  font-size: var(--text-sm);
  font-weight: 500;
  cursor: pointer;
}
.auth .demo-chip:hover {
  border-color: var(--line-strong);
}
