*,
*::before,
*::after {
  box-sizing: border-box;
}
body {
  margin: 0;
  height: 100%;
  color-scheme: light;
  background: var(--wash);
  background-attachment: fixed;
  color: var(--ink-2);
  font-family: var(--font-sans);
  font-size: var(--text-base);
  font-weight: 400;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  -webkit-text-size-adjust: 100%;
}
h1,
h2,
h3,
h4 {
  margin: 0;
  color: var(--ink);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.25;
  overflow-wrap: anywhere;
}
h1 {
  font-size: var(--text-xl);
}
h2 {
  font-size: var(--text-md);
}
.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-card);
  box-shadow: var(--highlight), var(--shadow-1);
}
.card-link {
  display: block;
  color: inherit;
  text-decoration: none;
  transition:
    transform 180ms var(--ease-out),
    border-color 180ms ease,
    box-shadow 180ms ease;
}
.card-link:hover {
  border-color: #d5d9e0;
  box-shadow: var(--highlight), var(--shadow-2);
  transform: translateY(-2px);
}
@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
}
.rise-in {
  animation: rise-in 420ms var(--ease-out) both;
  animation-delay: calc(var(--i, 0) * 40ms);
}
.label {
  color: var(--ink-3);
  font-size: var(--text-sm);
  font-weight: 500;
}
.muted {
  color: var(--ink-3);
}
.num {
  font-variant-numeric: tabular-nums;
}
.sr-only {
  position: absolute !important;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
:where(a) {
  color: var(--brand-deep);
}
mat-icon.mat-icon {
  font-variation-settings: "wght" 300, "opsz" 20;
}
.mat-mdc-unelevated-button:not(:disabled) {
  transition: transform var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
}
.mat-mdc-unelevated-button:not(:disabled):hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 10px -4px rgba(16, 24, 40, 0.35);
}
.mat-mdc-outlined-button:not(:disabled) {
  background: var(--surface);
  box-shadow: var(--shadow-card);
}
.mat-mdc-outlined-button:not(:disabled):hover {
  border-color: #d5d9e0;
}
html :focus-visible:not(.mat-mdc-input-element):not(.mat-mdc-select):not(textarea):not(select):not(input:not([type=checkbox]):not([type=radio])) {
  outline: 2px solid var(--brand-deep);
  outline-offset: 2px;
  box-shadow: var(--ring);
}
html :where(input:not([type=checkbox]):not([type=radio]), textarea, select):focus {
  outline: none;
  border-color: var(--brand-deep);
  box-shadow: var(--field-ring);
}
html :is(.wrap, .pwbox, .search, .prefixed) :is(input, textarea, select):focus {
  box-shadow: none !important;
}
.pill-tabs {
  --mat-tab-active-indicator-height: 0;
  --mat-tab-divider-height: 0;
  --mat-tab-inactive-label-text-color: var(--ink-2);
}
.pill-tabs .mdc-tab {
  min-width: 0;
  margin-right: 4px;
  padding: 0 16px;
  border-radius: var(--radius-pill);
}
.pill-tabs .mdc-tab--active {
  background: var(--surface);
  box-shadow: var(--highlight), var(--shadow-1);
}
.pill-tabs .mat-mdc-tab-header {
  display: inline-flex;
  padding: 4px;
  margin-bottom: var(--space-3);
  border-radius: var(--radius-pill);
  background: var(--tint-slate);
}
.mat-mdc-menu-panel {
  border: 1px solid var(--line);
  min-width: 200px !important;
}
.mat-mdc-menu-item {
  min-height: 40px !important;
}
html .mat-mdc-menu-panel .mat-mdc-menu-item:focus-visible {
  outline: 2px solid var(--brand-deep);
  outline-offset: -2px;
  box-shadow: none;
}
.mat-bottom-sheet-container {
  border-radius: var(--radius-card) var(--radius-card) 0 0 !important;
}
.flyout {
  min-width: 208px;
  padding: 6px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
  box-shadow: var(--shadow-pop);
}
.flyout-title {
  padding: 6px 10px 8px;
  color: var(--ink-3);
  font-size: var(--text-xs);
  font-weight: 500;
}
.flyout-user {
  display: flex;
  flex-direction: column;
  padding: 6px 10px 10px;
  margin-bottom: 4px;
  border-bottom: 1px solid var(--line);
}
.flyout-user strong {
  color: var(--ink);
  font-size: var(--text-sm);
  font-weight: 600;
}
.flyout-user span {
  color: var(--ink-3);
  font-size: var(--text-xs);
}
.flyout-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 36px;
  padding: 0 10px;
  border: 0;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--ink-2);
  font: inherit;
  font-size: var(--text-base);
  text-align: left;
  text-decoration: none;
  cursor: pointer;
}
.flyout-item:hover,
.flyout-item:focus {
  background: var(--subtle);
  color: var(--ink);
  outline: none;
}
.flyout-item:focus-visible {
  outline: 2px solid var(--brand-deep);
  outline-offset: -2px;
}
.flyout-item.active {
  background: var(--brand-tint);
  color: var(--ink);
  font-weight: 600;
}
.skeleton {
  display: block;
  border-radius: var(--radius-sm);
  background:
    linear-gradient(
      90deg,
      var(--plate) 0%,
      var(--subtle) 50%,
      var(--plate) 100%);
  background-size: 200% 100%;
  animation: shimmer 1.2s linear infinite;
}
@keyframes shimmer {
  from {
    background-position: 200% 0;
  }
  to {
    background-position: -200% 0;
  }
}
.nav-badge {
  min-width: 22px;
  margin-left: auto;
  padding: 0 7px;
  border-radius: var(--radius-pill);
  font-size: var(--text-xs);
  font-weight: 600;
  line-height: 20px;
  text-align: center;
}
.nav-badge + .chevron {
  margin-left: 6px;
}
.rail-item:has(.nav-dot) {
  position: relative;
}
.nav-dot {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 8px;
  height: 8px;
  border: 2px solid var(--surface);
  border-radius: 50%;
  box-sizing: content-box;
}
.nav-badge.tone-rose {
  background: var(--tint-rose);
  color: var(--tint-rose-ink);
}
.nav-badge.tone-amber {
  background: var(--tint-amber);
  color: var(--tint-amber-ink);
}
.nav-dot.tone-rose {
  background: var(--data-rose);
}
.nav-dot.tone-amber {
  background: var(--data-amber);
}
.table-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

