# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# --- Django ---
# Generate one: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- MySQL (database `crm_pm` must already exist, utf8mb4) ---
DB_NAME=crm_pm
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
