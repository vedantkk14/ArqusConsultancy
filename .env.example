# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# --- Django ---
# Generate one: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- MySQL (database `crm_pm` must already exist, utf8mb4) ---
DB_NAME=crm_pm
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Auth ---
# Where the Angular app runs; used to build password-reset links.
FRONTEND_URL=http://localhost:4200
# Consecutive failed logins (per identifier + IP) before a temporary lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Password-reset link lifetime, in seconds.
PASSWORD_RESET_TIMEOUT=3600

# --- Email ---
# Dev default prints emails (including reset links) to the backend terminal.
# Production: django.core.mail.backends.smtp.EmailBackend plus the SMTP settings below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ARQUS CRM <no-reply@localhost>
