        }
      </select>
    </label>
  }
  <label class="dd">
    <span class="lbl">Source</span>
    <select class="ctl" (change)="set('source', $any($event.target).value)">
      <option value="" [selected]="!filters().source">Any source</option>
      @for (s of sources; track s[0]) {
        <option [value]="s[0]" [selected]="filters().source === s[0]">{{ s[1] }}</option>
      }
    </select>
  </label>
  @if (mode() === 'all') {
    <label class="dd">
      <span class="lbl">Follow-up</span>
      <select class="ctl" (change)="set('followup', $any($event.target).value)">
        <option value="" [selected]="!filters().followup">Any</option>
        <option value="overdue" [selected]="filters().followup === 'overdue'">Overdue</option>
        <option value="today" [selected]="filters().followup === 'today'">Today</option>
        <option value="upcoming" [selected]="filters().followup === 'upcoming'">Upcoming</option>
        <option value="none" [selected]="filters().followup === 'none'">None</option>
      </select>
    </label>
  }
  <label class="dd">
    <span class="lbl">Created from</span>
    <input class="ctl" type="date" [value]="filters().created_from" (change)="set('created_from', $any($event.target).value)" />
  </label>
  <label class="dd">
    <span class="lbl">Created to</span>
    <input class="ctl" type="date" [value]="filters().created_to" (change)="set('created_to', $any($event.target).value)" />
