            [class.busy]="expensesLoading() && expensesLoaded()"
            [attr.aria-busy]="expensesLoading()"
          >
            <app-expense-rows
              [rows]="expenses()"
              [layout]="wide() ? 'table' : 'cards'"
              [skeleton]="!expensesLoaded()"
              [showAmount]="!isSalesManager()"
              (action)="onExpenseAction($event)"
            />
          </div>
          @if (expenses().length < expenseCount()) {
            <div class="more">
              <button
                matButton="outlined"
                type="button"
                [disabled]="expensesLoading()"
                (click)="loadMoreExpenses()"
              >
                {{ expensesLoading() ? 'Loading\u2026' : 'Load more' }}
              </button>
            </div>
          }
        }
      </section>
    </div>

    <aside class="side">
      <!-- Finance (admin only: not rendered at all for a project manager) -->
      @if (isAdmin()) {
        <section class="card panel rise-in" style="--i: 2" aria-labelledby="fin-title">
          <app-panel-head
            title="Finance"
            subtitle="From the accounts ledger"
            headingId="fin-title"
          />
          @if (p.finance; as f) {
            <dl class="kv">
              <dt>Deal total</dt>
              <dd class="num">{{ f.total_amount | inr }}</dd>
              <dt>Received</dt>
              <dd class="num">{{ f.received | inr }}</dd>
              <dt>Outstanding</dt>
              <dd class="num">{{ f.outstanding | inr }}</dd>
              <dt>Live margin</dt>
              <dd class="num" [class.neg]="isNegative(f.live_margin)">{{ f.live_margin | inr }}</dd>
            </dl>
            @if (!f.finalized) {
              <p class="small">The deal is not finalized yet.</p>
            } @else if (f.ledger_id) {
              <button matButton="outlined" class="revise" type="button" (click)="reviseTotal(p)">
                <mat-icon>edit</mat-icon>Revise total
              </button>
            }
          } @else {
            <p class="small">Awaiting accounts data</p>
          }
        </section>
      }

      <section class="card panel rise-in" style="--i: 3" aria-labelledby="scope-title">
        <app-panel-head title="Scope" headingId="scope-title" />
        <p class="pre">{{ p.scope || 'No scope written.' }}</p>
      </section>

      <section class="card panel rise-in" style="--i: 4" aria-labelledby="tl-title">
        <app-panel-head title="Timeline" subtitle="Newest first" headingId="tl-title" />
        <app-project-timeline [projectId]="p.id" [refresh]="timelineTick()" />
      </section>
    </aside>
  </div>

  <!-- Phones: sticky Add expense | Complete | More -->
  @if (
    !layout.isDesktop() &&
    (can('add_expense') || can('complete') || can('reopen') || can('reassign'))
  ) {
    <nav class="mbar" aria-label="Project actions">
      @if (can('add_expense')) {
        <button
          type="button"
          class="pri"
          [attr.aria-label]="'Add expense to ' + p.name"
          (click)="addExpense()"
        >
          <mat-icon aria-hidden="true">add</mat-icon>Add expense
        </button>
      }
      @if (can('complete')) {
        <button type="button" [attr.aria-label]="'Complete ' + p.name" (click)="complete(p)">
          <mat-icon aria-hidden="true">check_circle</mat-icon>Complete
        </button>
      }
      @if (can('reopen')) {
        <button
          type="button"
          class="pri"
          [attr.aria-label]="'Reopen ' + p.name"
          (click)="reopen(p)"
        >
          <mat-icon aria-hidden="true">restart_alt</mat-icon>Reopen
        </button>
      }
      @if (can('reassign')) {
        <button
          type="button"
          class="ib"
          [matMenuTriggerFor]="over"
          [attr.aria-label]="'More actions for ' + p.name"
        >
          <mat-icon aria-hidden="true">more_vert</mat-icon>
        </button>
        <mat-menu #over="matMenu" xPosition="before">
          <button mat-menu-item type="button" (click)="reassign(p)">
            <mat-icon>person</mat-icon>Reassign manager
          </button>
        </mat-menu>
      }
    </nav>
  }

  <ng-template #expenseForm>
    <div class="xp" [class.in-sheet]="!layout.isDesktop()">
      <app-dialog-head
        [headingId]="expenseTitleId"
        [title]="editing() ? 'Edit expense' : 'Add expense'"
        [subtitle]="p.name"
        (closed)="closeExpense()"
      />
      <app-add-expense-form
        [project]="{ id: p.id, name: p.name }"
        [expense]="editing()"
        [inSheet]="true"
        (saved)="onExpenseSaved()"
        (cancelled)="closeExpense()"
      />
    </div>
  </ng-template>
} @else {
  <app-empty-state
    icon="assignment"
    title="Project not found"
    message="It may not exist, or it isn't assigned to you."
  >
    <a matButton="filled" routerLink="/projects/running">Back to projects</a>
  </app-empty-state>
}
